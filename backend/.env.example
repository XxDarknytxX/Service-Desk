# Server
PORT=5000
NODE_ENV=production

# CORS - the origin the browser loads the app from.
# NGINX serves the frontend and proxies /api on the SAME origin, so this only
# matters if you ever host the frontend separately. Use the server's URL:
#   http://27.123.188.86   (plain HTTP by IP)   or   https://your.domain
CORS_ORIGIN=http://localhost:3000

# MySQL
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=servicedesk
DATABASE_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DATABASE_NAME=service_desk

# JWT - generate a strong random secret: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_GENERATE_STRONG_SECRET

# AnythingLLM Configuration (optional - remove if not using AI chat)
ANYTHINGLLM_URL=http://localhost:3001/api/v1
ANYTHINGLLM_API_KEY=CHANGE_ME
ANYTHINGLLM_WORKSPACE=my-workspace
